      "ice_accent": { "value": "#8DB5FF", "type": "color", "description": "Azul celeste para destaques, links e sparkles" },
      "card_surface": { "value": "#1A2338", "type": "color", "description": "Superfície de cartões e painéis" },
      "border_neutral": { "value": "#3B4B6B", "type": "color", "description": "Linhas e bordas secundárias" },
      "light_surface": { "value": "#E2E8F0", "type": "color", "description": "Divisórias claras e alto contraste" },
      "white": { "value": "#FFFFFF", "type": "color", "description": "Tipografia de alto contraste" }
