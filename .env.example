# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development
APP_NAME=prometeus
APP_VERSION=0.0.0
PRODUCT_NAME="Prometeus"
PRODUCT_DESCRIPTOR="Inteligência para Produtos Educacionais"
PRODUCT_VENDOR_NAME="Agência Prometeus"
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
INSTITUTION_ID=ens
INSTITUTION_CONFIG_PATH=config/tenants/ens.example.yaml
SCORING_PROFILE_PATH=config/scoring/default-v1.example.yaml

# =============================================================================
# DATABASE, QUEUE AND CACHE
# Replace all example passwords before running outside local development.
# =============================================================================
DATABASE_URL=postgresql+asyncpg://prometeus:change_me@postgres:5432/prometeus
REDIS_URL=redis://redis:6379/0
EVIDENCE_STORAGE_PATH=/var/lib/prometeus/evidence
MARKET_CACHE_TTL_SECONDS=86400

# =============================================================================
# LLM TRADICIONAL / GENERATIVA (OBRIGATÓRIO)
# Responsável pela redação dos dossiês, chatbot conversacional e expansão semântica.
# Caso o JEV (TypeSafe) não esteja conectado, esta LLM assume AUTOMATICAMENTE
# também os julgamentos estruturados (Modo 100% Tradicional).
#
# Suporta:
# 1) API Keys padrão (OpenAI, Anthropic Claude, Google Gemini)
# 2) Conexão Direta ChatGPT OAuth / Codex (estilo Hermes-Agent / OpenClaw):
#    permite autenticar uma conta ChatGPT e consumir sua cota/limite nativo.
# =============================================================================
GEN_LLM_PROVIDER=openai  # openai, chatgpt_oauth, codex, anthropic, gemini, openrouter

# Modelos recomendados:
# - ChatGPT OAuth / Codex:
#     gpt-6-astra   (Máxima capacidade; raciocínio pesado, arquitetura, análise complexa)
#     gpt-6.1-sol   (Quase nível Astra, mais eficiente; melhor equilíbrio)
#     gpt-5.6-sol   (Linha Sol balanceada)
#     gpt-5.6-terra (Propósito geral / equilibrado)
#     gpt-5.6-luna  (Ultrarrápido, econômico, tarefas diretas)
# - API OpenAI Tradicional: gpt-4o, gpt-4o-mini, o1, o3-mini
GEN_LLM_MODEL=gpt-4o-mini

# Nível de Raciocínio (para modelos que suportam raciocínio configurável como a linha Codex/o-series):
# Opções: none, low, medium, high, extra_high, max
# Quando definido como diferente de 'none', o sistema envia 'reasoning_effort' e ajusta a chamada
# sem enviar 'temperature' (evitando erros de incompatibilidade da API).
GEN_LLM_REASONING_EFFORT=medium

GEN_LLM_TIMEOUT_SECONDS=60

# Opção 1: Chaves de API de Provedores Padrão
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Opção 2: uso direto do plano ChatGPT pelo OAuth oficial "Sign in with ChatGPT".
# Não cole token manualmente. Use "Continuar com ChatGPT" na tela de configurações.
# As credenciais rotativas e o modelo descoberto na conta ficam em arquivo local ignorado pelo Git.
CHATGPT_ACCESS_TOKEN=
CHATGPT_CREDENTIALS_PATH=var/chatgpt/credentials.json
OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# JEV / TYPESAFE AI (OPCIONAL — HABILITA MODO HÍBRIDO)
# Modelo "System One" (https://docs.typesafe.ai/introduction) para decisões
# atômicas tipadas (Choice, Score, Noul) com probabilidades e índices de confiança.
#
# - SE PREENCHIDO: Habilita Modo Híbrido (JEV para decisões + LLM Tradicional para textos).
# - SE VAZIO: Chaveia AUTOMATICAMENTE para o Modo 100% Tradicional (sem quebras).
# =============================================================================
TYPESAFE_API_KEY=
JEV_MODEL=jev-v1.2.0
JEV_TIMEOUT_SECONDS=15
JEV_MAX_RETRIES=2
JEV_REVIEW_CONFIDENCE_THRESHOLD=0.75
JEV_BASE_URL=https://api.typesafe.ai/v1

# =============================================================================
# APIFY / WEB DATA COLLECTION
# Actor IDs must be selected, evaluated and pinned during Phase 04.
# =============================================================================
APIFY_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_MAX_TOTAL_CHARGE_USD_PER_ANALYSIS=5.00
# Formato obrigatório: owner/name@build-number. Revalide schema, preço e termos
# antes de promover builds diferentes. Os exemplos abaixo foram verificados em 2026-10-27.
APIFY_ACTOR_GOOGLE_SEARCH=apify/google-search-scraper@0.0.473
APIFY_ACTOR_WEB_CRAWLER=apify/website-content-crawler@0.3.102
APIFY_ACTOR_META_AD_LIBRARY=igolaizola/facebook-ad-library-scraper@0.0.59
APIFY_ACTOR_LINKEDIN=harvestapi/linkedin-company-search@0.0.21
APIFY_ACTOR_LINKEDIN_JOBS=curious_coder/linkedin-jobs-scraper@1.7.18
APIFY_ACTOR_INSTAGRAM=apify/instagram-scraper@0.0.831
APIFY_ACTOR_TIKTOK=clockworks/tiktok-scraper@0.0.625
APIFY_ACTOR_YOUTUBE_COMMENTS=streamers/youtube-comments-scraper@0.0.257
APIFY_ACTOR_REDDIT=trudax/reddit-scraper-lite@5.8.7
APIFY_ACTOR_GOOGLE_TRENDS=apify/google-trends-scraper@0.0.143
# Google Analytics só deve ser configurado para propriedades autorizadas do tenant.
APIFY_ACTOR_GOOGLE_ANALYTICS=
APIFY_REQUIRED_SOURCES=google_search,web_crawler,meta_ads_library,linkedin,linkedin_jobs,instagram,tiktok,youtube_comments

# =============================================================================
# GOOGLE
# Google Trends official API is optional and subject to access approval.
# =============================================================================
GOOGLE_TRENDS_ENABLED=false
GOOGLE_TRENDS_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# =============================================================================
# META
# Official Ad Library API coverage must be verified per country and ad type.
# Commercial-ad collection for Brazil is planned through a vetted Apify Actor.
# =============================================================================
META_AD_LIBRARY_ENABLED=false
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=

# =============================================================================
# INSTITUTIONAL CRM ADAPTER
# Use "mock" until the ENS contracts and credentials are configured.
# =============================================================================
INSTITUTIONAL_ADAPTER=mock
INTERNAL_LEADS_API_URL=
INTERNAL_INSCRITOS_API_URL=
INTERNAL_MATRICULADOS_API_URL=
INTERNAL_API_AUTH_TYPE=bearer
INTERNAL_API_BEARER_TOKEN=
INTERNAL_API_KEY=
INTERNAL_API_TIMEOUT_SECONDS=30

# =============================================================================
# REST, MCP AND WEBHOOK SECURITY
# Generate strong unique values per deployment.
# =============================================================================
SERVICE_API_KEYS=
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8001
WEBHOOK_SIGNING_SECRET=
WEBHOOK_MAX_RETRIES=8
WEBHOOK_ALLOWED_HOSTS=
DATA_ENCRYPTION_KEY=

# =============================================================================
# OBSERVABILITY
# =============================================================================
OTEL_SERVICE_NAME=prometeus
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
METRICS_ENABLED=true
TRACING_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
