# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development
APP_NAME=course-market-intelligence
APP_VERSION=0.0.0
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
INSTITUTION_ID=ens
INSTITUTION_CONFIG_PATH=config/tenants/ens.example.yaml
SCORING_PROFILE_PATH=config/scoring/default-v1.example.yaml

# =============================================================================
# DATABASE, QUEUE AND CACHE
# Replace all example passwords before running outside local development.
# =============================================================================
DATABASE_URL=postgresql+asyncpg://course_market:change_me@postgres:5432/course_market
REDIS_URL=redis://redis:6379/0
EVIDENCE_STORAGE_PATH=/var/lib/course-market/evidence
MARKET_CACHE_TTL_SECONDS=86400

# =============================================================================
# JEV / TYPESAFE AI (mandatory for a complete analysis)
# =============================================================================
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=15
JEV_MAX_RETRIES=2
JEV_REVIEW_CONFIDENCE_THRESHOLD=0.75
# Pin a validated model version before production.

# =============================================================================
# GENERATIVE LLM (choose one provider per deployment)
# =============================================================================
GEN_LLM_PROVIDER=openai
GEN_LLM_MODEL=
GEN_LLM_TIMEOUT_SECONDS=90
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# =============================================================================
# APIFY / WEB DATA COLLECTION
# Actor IDs must be selected, evaluated and pinned during Phase 04.
# =============================================================================
APIFY_TOKEN=
APIFY_MAX_TOTAL_CHARGE_USD_PER_ANALYSIS=5.00
APIFY_ACTOR_META_AD_LIBRARY=
APIFY_ACTOR_INSTAGRAM=
APIFY_ACTOR_TIKTOK=
APIFY_ACTOR_YOUTUBE_COMMENTS=
APIFY_ACTOR_GOOGLE_JOBS=
APIFY_ACTOR_GOOGLE_SEARCH=
APIFY_ACTOR_WEB_CRAWLER=

# =============================================================================
# GOOGLE
# Google Trends official API is optional and subject to access approval.
# =============================================================================
GOOGLE_TRENDS_ENABLED=false
GOOGLE_TRENDS_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# =============================================================================
# META
# Official Ad Library API coverage must be verified per country and ad type.
# Commercial-ad collection for Brazil is planned through a vetted Apify Actor.
# =============================================================================
META_AD_LIBRARY_ENABLED=false
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=

# =============================================================================
# INSTITUTIONAL CRM ADAPTER
# Use "mock" until the ENS contracts and credentials are configured.
# =============================================================================
INSTITUTIONAL_ADAPTER=mock
INTERNAL_LEADS_API_URL=
INTERNAL_INSCRITOS_API_URL=
INTERNAL_MATRICULADOS_API_URL=
INTERNAL_API_AUTH_TYPE=bearer
INTERNAL_API_BEARER_TOKEN=
INTERNAL_API_KEY=
INTERNAL_API_TIMEOUT_SECONDS=30

# =============================================================================
# REST, MCP AND WEBHOOK SECURITY
# Generate strong unique values per deployment.
# =============================================================================
SERVICE_API_KEYS=
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8001
WEBHOOK_SIGNING_SECRET=
WEBHOOK_MAX_RETRIES=8
WEBHOOK_ALLOWED_HOSTS=
DATA_ENCRYPTION_KEY=

# =============================================================================
# OBSERVABILITY
# =============================================================================
OTEL_SERVICE_NAME=course-market-intelligence
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
METRICS_ENABLED=true
TRACING_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
